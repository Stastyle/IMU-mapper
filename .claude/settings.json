{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(../gradlew *)",
      "Bash(python tools/replay.py *)",
      "Bash(python3 tools/replay.py *)",
      "PowerShell(.\\gradlew.bat *)",
      "PowerShell(..\\gradlew.bat *)",
      "PowerShell(python tools/replay.py *)",
      "PowerShell(python tools\\replay.py *)"
    ],
    "deny": [
      "Read(/**/*.jks)",
      "Read(/**/*.keystore)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*.base64)"
    ]
  }
}

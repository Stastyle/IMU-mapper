<?xml version="1.0" encoding="utf-8"?>
<!--
    An angular route with round nodes, as the viewer draws a walk. Everything stays inside the 66 dp
    safe zone (a circle of radius 33 around 54,54), so no launcher mask clips a node. The monochrome
    layer (ic_launcher_monochrome) repeats this geometry; change both together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft glow under the route. -->
    <path
        android:pathData="M37,72 L44,54 L59,60 L62,45 L72,37"
        android:strokeColor="#29B6F6"
        android:strokeAlpha="0.3"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M37,72 L44,54 L59,60 L62,45 L72,37"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- Turning points. -->
    <path
        android:pathData="M39,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z M54,60 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z M57,45 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"
        android:fillColor="#4FC3F7" />
    <!-- Start and end: rings, hollowed with the background colour. -->
    <path
        android:pathData="M30.5,72 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z M65.5,37 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z"
        android:fillColor="#4FC3F7" />
    <path
        android:pathData="M34.2,72 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 Z M69.2,37 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0 Z"
        android:fillColor="#10233A" />
</vector>
